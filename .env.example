# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (Optional for persistent pgvector storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here

# GitHub Token (Optional, avoids GitHub API unauthenticated rate limits)
GITHUB_TOKEN=your_personal_access_token_if_available
